# Copied to /etc/cloudsentry.env by setup-ec2.sh. Read by the systemd service.
# Do not add AWS access keys: on EC2 the backend uses the instance role automatically.
AWS_REGION=ca-central-1

# Optional: enable AI analysis (see README "Choosing a model").
# BEDROCK_MODEL_ID=your-model-id
# BEDROCK_REGION=

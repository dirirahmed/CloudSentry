# Base URL of the CloudSentry API as seen from the browser.
# "/api" works with the Vite dev proxy (npm run dev) and with deploy/nginx.conf.
# Only change it if you serve the API under a different path.
#
# Never put AWS credentials in this file: every VITE_ variable is embedded in the
# public JavaScript bundle. AWS credentials belong to the backend only.
VITE_API_URL=/api
